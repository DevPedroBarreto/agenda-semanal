{
  "info": {
    "_postman_id": "1a90223e-fb0d-40be-96cf-1cd4ca32dc45",
    "name": "API Agenda",
    "description": "This collection covers the core endpoints of the Agenda API, a REST service running locally on port 8080 that manages appointments (compromissos).\n\nIt includes requests to:\n\n- Retrieve all appointments (GET /compromissos)\n    \n- Retrieve a specific appointment by ID (GET /compromissos/:id)\n    \n- Create a new appointment with details such as title, day, start/end time, and category (POST /compromissos)\n    \n- Test error handling by requesting a non-existent appointment ID (GET /compromissos/999)\n    \n\nUse this collection to develop, test, and validate the appointment management features of the Agenda API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "49174196",
    "_collection_link": "https://go.postman.co/collection/49174196-1a90223e-fb0d-40be-96cf-1cd4ca32dc45?source=collection_link"
